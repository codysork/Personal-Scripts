#!/usr/bin/env bash
# @file config
# @author Cody Sork <codysork@gmail.com>
# @created 2026-11-21
# @modified 2026-11-21
# @description Master configuration for the user-scripts suite.
#
# This file is sourced by the scripts, not executed. Every scalar value uses
# the ${VAR:-default} form so an environment variable takes precedence:
#
#   DAYS_DUE=14 maintenance-reminder.sh
#
# Arrays are config-only; they have no environment-variable override.
#
# The defaults below are intentionally generic. Edit the deployed copy to set
# values for your own machine, keeping the ${VAR-...} form so environment
# overrides keep working:
#
#   BACKUP_DIR="${BACKUP_DIR:-$HOME/Backup}"
#   SERVER="${SERVER-my.server.example}"
#
# install.sh deploys a copy to:
#   ${XDG_CONFIG_HOME:-$HOME/.config}/user-scripts/config
# Set USER_SCRIPTS_CONFIG to load a different file. A legacy config.conf in
# that directory is still recognized.

#------------------------------------------------------------------------------
# Shared paths (used by more than one script — keep in sync here)
#------------------------------------------------------------------------------

BACKUP_DIR="${BACKUP_DIR:-$HOME/Backup}"
ARCHIVE_HEADER="${ARCHIVE_HEADER:-backup}"
STATE_DIR="${STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/arch-maintenance}"

#------------------------------------------------------------------------------
# backup.sh
#------------------------------------------------------------------------------

BACKUP_SOURCES=(
    "$HOME/.config"
    "$HOME/.local/share"
    "$HOME/Documents"
    "$HOME/Pictures"
)

EXCLUDES=()

#------------------------------------------------------------------------------
# arch-maintenance.sh
#------------------------------------------------------------------------------

MAX_BACKUP_AGE_DAYS="${MAX_BACKUP_AGE_DAYS:-30}"
MIN_SNAPSHOTS="${MIN_SNAPSHOTS:-3}"
MAX_SNAPSHOT_AGE_DAYS="${MAX_SNAPSHOT_AGE_DAYS:-30}"
GIT_CHECKER="${GIT_CHECKER:-/usr/local/bin/git-checker.sh}"

#------------------------------------------------------------------------------
# maintenance-reminder.sh
#------------------------------------------------------------------------------

DAYS_DUE="${DAYS_DUE:-6}"

# Leave SERVER empty to disable remote maintenance checks. When setting your
# own host, keep the ${SERVER-...} form so environment overrides still work.
SERVER="${SERVER-}"
SERVER_USER="${SERVER_USER-}"
SSH_TIMEOUT="${SSH_TIMEOUT:-5}"
REMOTE_STATE_DIR="${REMOTE_STATE_DIR:-.local/state/arch-maintenance}"

#------------------------------------------------------------------------------
# git-checker.sh
#------------------------------------------------------------------------------

SEARCH_DIR="${SEARCH_DIR:-$HOME}"

IGNORE_DIRS=(
    "$HOME/.cache"
    "$HOME/.local/share"
)
