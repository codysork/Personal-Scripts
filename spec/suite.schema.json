{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bash-suite.schema.json",
  "title": "Bash script suite specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "shell",
    "policy",
    "scripts",
    "tests"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "shell": {
      "const": "bash"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_network",
        "allowed_hosts",
        "allowed_write_paths",
        "allow_sudo",
        "require_confirmation_for_destructive",
        "default_timeout_seconds"
      ],
      "properties": {
        "allow_network": {
          "type": "boolean"
        },
        "allowed_hosts": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "allowed_write_paths": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "allow_sudo": {
          "type": "boolean"
        },
        "require_confirmation_for_destructive": {
          "type": "boolean"
        },
        "default_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scripts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "purpose",
          "invocation",
          "arguments",
          "environment",
          "effects",
          "exit_codes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^[^/].*\\.sh$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "invocation": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "required", "description"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": {
                  "enum": ["string", "integer", "boolean", "path"]
                },
                "required": { "type": "boolean" },
                "description": { "type": "string" },
                "default": {}
              }
            }
          },
          "environment": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "description"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Z_][A-Z0-9_]*$"
                },
                "description": { "type": "string" },
                "default": { "type": "string" }
              }
            }
          },
          "effects": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "read_paths",
              "write_paths",
              "network_hosts",
              "subprocesses",
              "uses_sudo",
              "destructive"
            ],
            "properties": {
              "read_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "write_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "network_hosts": {
                "type": "array",
                "items": { "type": "string" }
              },
              "subprocesses": {
                "type": "array",
                "items": { "type": "string" }
              },
              "uses_sudo": { "type": "boolean" },
              "destructive": { "type": "boolean" }
            }
          },
          "exit_codes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "meaning"],
              "properties": {
                "code": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "meaning": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "expected_exit"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "expected_exit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}

